{
  "name": "@cosmicdanish1/water-wave",
  "private": false,
  "version": "0.1.0",
  "description": "Interactive stylised water for three.js: waves, reflections, caustics, ripples, and objects that float, splash and interact with the surface. Works on web, mobile, desktop and TV, and as an animated UI background.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmicdanish1/water-wave-animation.git"
  },
  "homepage": "https://github.com/cosmicdanish1/water-wave-animation#readme",
  "keywords": [
    "three",
    "threejs",
    "water",
    "ocean",
    "waves",
    "caustics",
    "ripples",
    "webgl",
    "shader",
    "buoyancy",
    "splash"
  ],
  "main": "./dist/water-wave.umd.js",
  "module": "./dist/water-wave.es.js",
  "exports": {
    ".": {
      "import": "./dist/water-wave.es.js",
      "require": "./dist/water-wave.umd.js"
    },
    "./react": "./src/water/react.js",
    "./src": "./src/water/index.js"
  },
  "files": [
    "dist",
    "src/water"
  ],
  "peerDependencies": {
    "three": ">=0.150.0",
    "react": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "prepare": "vite build --mode lib",
    "prepublishOnly": "npm run lint && npm test && npm run build:lib"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "tweakpane": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "tweakpane": "^4.0.5",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
